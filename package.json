{
  "name": "@fethcat/store",
  "version": "0.0.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "package.json"
  ],
  "license": "ISC",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier -w \"{src,tests}/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "vitest run --coverage",
    "version:patch": "fethca-version patch",
    "version:minor": "fethca-version minor",
    "version:major": "fethca-version major"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:fethca/store.git"
  },
  "devDependencies": {
    "@fethcat/eslint-plugin": "^0.0.3",
    "@fethcat/prettier-config": "^1.0.5",
    "@fethcat/tests": "^0.0.16",
    "@fethcat/version": "^0.0.17",
    "@types/node": "^24.19.4",
    "@vitest/coverage-v8": "^5.1.2",
    "dotenv": "^16.6.1",
    "mockdate": "^3.0.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "prettier": "@fethcat/prettier-config",
  "eslintConfig": {
    "extends": [
      "plugin:@fethcat/back"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.9"
